DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=

# Comma-separated Discord role snowflakes for bot admin commands.
# Guild owner + Administrator always allowed.
ADMIN_ROLE_IDS=

DATABASE_PATH=./data/challenges.db
CHALLENGE_CATALOG=./challenges/2026.yaml
# Congrats gifs/images for completion posts (tier + content/ subfolders)
CONGRATS_DIR=./completion_pictures

# Deep Weeb Club 2026 (override in admin Settings UI too)
TADOKU_API_BASE=https://tadoku.app/api/internal/immersion
TADOKU_CONTEST_ID=90e6509e-bc32-49d4-936d-ea0776eee602

ANNOUNCE_CHANNEL_ID=1187153489156124732
# start + complete/fail (+ congrats)
# Cards only (start/finish/fail/…); congrats stay on main announce channel
ANNOUNCE_SECONDARY_CHANNEL_ID=1523503572652916786
# schedule + start + status + complete/fail + everything else
# JSON object string optional; prefer admin UI. Example:
# REWARD_ROLES={"easy":"","medium":"","hard":"","ota_master":"","any_clear":""}

ALLOW_REATTEMPT=false
# Users may complete tadoku goals with confirm filter=honor when logs fail
ALLOW_HONOR_OVERRIDE=true
PAGES_PER_VOLUME=180
EPISODE_MINUTES=24

# Status cards / progress (also tunable in admin Settings UI)
STATUS_UPDATES_ENABLED=false
STATUS_POLL_MINUTES=2
STATUS_MIN_INTERVAL_MINUTES=12
STATUS_TIME_MILESTONES=false
STATUS_GOAL_MILESTONES=false
STATUS_AUTO_COMPLETE=true
STATUS_TIME_FRACS_LONG=25,50,75
STATUS_TIME_FRACS_SHORT=50
STATUS_GOAL_FRACS=25,50,75
STATUS_LONG_WINDOW_DAYS=7
STATUS_FINAL_HOUR_PUBLIC=false
STATUS_FINAL_HOUR_DM=true
STATUS_FINAL_HOUR_MINUTES=60
# Mid-run status cards off by default (start + clear only)
ANNOUNCE_STATUS=false
# Failed /confirm channel post (default off — mistaken completes)
ANNOUNCE_FAIL=false
MONTHLY_DIGEST_ENABLED=true
MONTHLY_DIGEST_HOUR=12
# MONTHLY_DIGEST_TZ=America/New_York

# Admin web UI (HTTP Basic). Empty password = open (LAN only — do not expose).
UI_HOST=0.0.0.0
UI_PORT=8090
UI_USERNAME=admin
UI_PASSWORD=

LOG_LEVEL=info

# Optional: MyAnimeList API client id for better anime/manga covers on cards.
# Without it we still try AniList (keyless) + VNDB for VNs.
# MAL_CLIENT_ID=
